# Auth.js (NextAuth v5) ------------------------------------------------------
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Set to true when running behind a reverse proxy (Vercel, Nginx, etc.)
AUTH_TRUST_HOST=true

# MongoDB --------------------------------------------------------------------
# Replace <db_password> with the real database user password.
MONGODB_URI=mongodb+srv://bogdan96degtyar_db_user:<db_password>@cluster0.sa2vgfu.mongodb.net/note_taking_app?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=note_taking_app

# Optional: Google OAuth (login "with Google" activates only when both are set)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
